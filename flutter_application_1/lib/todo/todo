Estructura de carpetas:

```
lib/
├── main.dart
├── models/
│   └── user_model.dart
├── services/
│   ├── auth_service.dart
│   └── user_service.dart
├── widgets/
│   ├── auth_background.dart
│   ├── auth_card.dart
│   ├── custom_text_field.dart
│   └── primary_button.dart
└── screens/
    ├── login_user_page.dart
    ├── register_user_page.dart
    └── users_page.dart
```

---

## 1. `lib/main.dart`

```dart
import 'package:flutter/material.dart';
import 'screens/login_user_page.dart';
import 'screens/register_user_page.dart';
import 'screens/users_page.dart';

// Punto de entrada: lo primero que se ejecuta.
void main() {
  runApp(const LoginApp()); // Arranca la app con el widget raíz
}

// Widget raíz. Es StatelessWidget porque no cambia su estado.
class LoginApp extends StatelessWidget {
  const LoginApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false, // Quita la etiqueta "DEBUG"
      title: 'Mi aplicacion',

      // Pantalla con la que inicia la app (cambiarla = cambiar la ruta)
      initialRoute: '/users',

      // Mapa de rutas con nombre: nombre -> pantalla
      routes: {
        '/login': (context) => const LoginPage(),
        '/register': (context) => const RegisterPage(),
        '/users': (context) => const UsersPage(),
      },
    );
  }
}
```

---

## 2. `lib/models/user_model.dart`

```dart
// MODELO: define cómo es un usuario (los datos que guarda).
class UserModel {
  int id;          // Identificador único
  String nombre;
  String correo;
  String password;

  // Constructor con parámetros nombrados y obligatorios
  UserModel({
    required this.nombre,
    required this.correo,
    required this.password,
    required this.id,
  });
}
```

---

## 3. `lib/services/auth_service.dart`

```dart
// SERVICIO de autenticación: solo contiene la lógica de validación.
// Devuelve un String? (mensaje de error) o null si todo está bien.
class AuthService {

  // Valida el formulario de login
  String? validarLogin({
    required String usuario,
    required String password,
  }) {
    // Si alguno está vacío, devuelve el error
    if (usuario.isEmpty || password.isEmpty) {
      return 'Completa usuario y contraseña';
    }
    return null; // null = todo correcto
  }

  // Valida el formulario de registro
  String? validarRegistro({
    required String nombre,
    required String correo,
    required String password,
    required String confirmarPassword,
  }) {
    // 1. Ningún campo vacío
    if (nombre.isEmpty ||
        correo.isEmpty ||
        password.isEmpty ||
        confirmarPassword.isEmpty) {
      return 'Completa todos los campos';
    }

    // 2. El correo debe contener @
    if (!correo.contains('@')) {
      return 'Ingresa un correo válido';
    }

    // 3. Contraseña de mínimo 6 caracteres
    if (password.length < 6) {
      return 'La contraseña debe tener al menos 6 caracteres';
    }

    // 4. Las dos contraseñas deben ser iguales
    if (password != confirmarPassword) {
      return 'Las contraseñas no coinciden';
    }

    return null; // Todo bien
  }
}
```

---

## 4. `lib/services/user_service.dart`

```dart
import '../models/user_model.dart';

// SERVICIO de usuarios: guarda la lista y tiene las operaciones del CRUD.
class UserService {

  // Lista privada (el _ la hace privada) con 3 usuarios de ejemplo
  final List<UserModel> _usuarios = [
    UserModel(id: 1, nombre: 'Yhoset Hernandez', correo: 'yhosepe@gmail.com', password: '123456'),
    UserModel(id: 2, nombre: 'Heriberto romero', correo: 'heridog@gmail.com', password: '123456'),
    UserModel(id: 3, nombre: 'Eliel Rodriguez', correo: 'Eliro@gmail.com', password: '123456'),
  ];

  // READ: devuelve toda la lista
  List<UserModel> obtenerUsuarios() {
    return _usuarios;
  }

  // CREATE: agrega un usuario al final
  void agregarUsuario(UserModel usuario) {
    _usuarios.add(usuario);
  }

  // UPDATE: busca por id y reemplaza ese usuario
  void actualizarUsuario(UserModel usuario) {
    // indexWhere devuelve la posición, o -1 si no lo encuentra
    final indice = _usuarios.indexWhere(
      (elemento) => elemento.id == usuario.id,
    );
    if (indice != -1) {
      _usuarios[indice] = usuario;
    }
  }

  // DELETE: elimina todos los que tengan ese id
  void eliminarUsuario(int id) {
    _usuarios.removeWhere(
      (usuario) => usuario.id == id,
    );
  }
}
```

