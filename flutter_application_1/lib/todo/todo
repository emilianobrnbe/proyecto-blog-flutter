## 5. `lib/widgets/auth_background.dart`

```dart
import 'package:flutter/material.dart';

// Fondo con degradado que se usa detrás del login y registro.
class AuthBackground extends StatelessWidget {
  final Widget child; // Lo que se dibuja encima del fondo

  const AuthBackground({
    super.key,
    required this.child,
  });

  @override
  Widget build(BuildContext context) {
    return Container(
      decoration: const BoxDecoration(
        // Degradado de esquina superior izquierda a inferior derecha
        gradient: LinearGradient(
          begin: Alignment.topLeft,
          end: Alignment.bottomRight,
          colors: [
            Color(0xFFE6F6FF),
            Color(0xFFBFD9FF),
            Color(0xFFD9D1FF),
            Color(0xFFE8DFFF),
          ],
        ),
      ),
      child: child,
    );
  }
}
```

