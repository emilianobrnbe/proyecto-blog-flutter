## 6. `lib/widgets/auth_card.dart`

```dart
import 'package:flutter/material.dart';

// Tarjeta blanca con sombra que contiene los formularios.
class AuthCard extends StatelessWidget {
  final Widget child;

  const AuthCard({
    super.key,
    required this.child,
  });

  @override
  Widget build(BuildContext context) {
    return Card(
      elevation: 10, // Altura de la sombra
      shape: RoundedRectangleBorder(
        borderRadius: BorderRadius.circular(14), // Esquinas redondeadas
      ),
      child: Padding(
        padding: const EdgeInsets.all(24), // Espacio interno
        child: SizedBox(
          width: 340, // Ancho fijo de la tarjeta
          child: child,
        ),
      ),
    );
  }
}
```

