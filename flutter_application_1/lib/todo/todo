## 7. `lib/widgets/custom_text_field.dart`

```dart
import 'package:flutter/material.dart';

// Campo de texto reutilizable con estilo propio.
class CustomTextField extends StatelessWidget {
  final TextEditingController controller; // Lee/escribe el texto
  final String label;                     // Texto flotante (etiqueta)
  final IconData prefixIcon;              // Ícono a la izquierda
  final bool obscureText;                 // true = oculta el texto (contraseña)
  final Widget? suffixIcon;               // Ícono opcional a la derecha (el ojito)
  final TextInputType keyboardType;       // Tipo de teclado

  const CustomTextField({
    super.key,
    required this.controller,
    required this.label,
    required this.prefixIcon,
    this.obscureText = false,                 // Valor por defecto
    this.suffixIcon,
    this.keyboardType = TextInputType.text,   // Valor por defecto
  });

  @override
  Widget build(BuildContext context) {
    return TextField(
      controller: controller,
      obscureText: obscureText,
      keyboardType: keyboardType,
      decoration: InputDecoration(
        labelText: label,
        prefixIcon: Icon(prefixIcon),
        suffixIcon: suffixIcon,
        border: OutlineInputBorder(
          borderRadius: BorderRadius.circular(6),
        ),
      ),
    );
  }
}
```

---

## 8. `lib/widgets/primary_button.dart`

```dart
import 'package:flutter/material.dart';

// Botón azul reutilizable que ocupa todo el ancho.
class PrimaryButton extends StatelessWidget {
  final String text;            // Texto del botón
  final VoidCallback onPressed; // Función que se ejecuta al presionar

  const PrimaryButton({
    super.key,
    required this.text,
    required this.onPressed,
  });

  @override
  Widget build(BuildContext context) {
    return SizedBox(
      width: double.infinity, // Todo el ancho disponible
      height: 48,
      child: ElevatedButton(
        onPressed: onPressed,
        style: ElevatedButton.styleFrom(
          backgroundColor: const Color(0xFF2196F3), // Color de fondo
          foregroundColor: Colors.white,            // Color del texto
          shape: RoundedRectangleBorder(
            borderRadius: BorderRadius.circular(25), // Muy redondeado
          ),
        ),
        child: Text(
          text,
          style: const TextStyle(
            fontSize: 16,
            fontWeight: FontWeight.bold,
          ),
        ),
      ),
    );
  }
}
```

